# ===== LLM Provider =====
# Options: openai | gemini | local
# Use "local" for any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio,
# OR a hosted proxy like OpenRouter (https://openrouter.ai).
LLM_PROVIDER=local
LLM_API_KEY=your-openrouter-or-openai-key-here
LLM_MODEL=openai/gpt-4o-mini
# For OpenRouter: https://openrouter.ai/api/v1
# For local Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# ===== Embedding model =====
# Options: openai | gemini | local
# "local" = free, runs on your own machine via sentence-transformers,
# no API key needed. Best choice if you don't have a paid OpenAI/Gemini key.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== Vector store =====
VECTOR_DB=chroma
VECTOR_DB_PATH=./data/vectorstore

# ===== Chunking =====
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=4

# ===== API security =====
# ADMIN key: full access (knowledge base, settings, logs, ingestion).
# Any random string. NEVER embed this in a public-facing website.
API_SECRET_KEY=change-me-to-a-random-secret

# Public CHAT key: auto-generated on first use, only unlocks /v1/chat and
# /v1/chat/stream. This is the key meant to be embedded in the default
# widget or a custom chat UI — safe to be visible in page source. View or
# rotate it from the admin panel's Integration page, or via
# GET/POST /v1/admin/chat-key (admin-key protected). Nothing to set here.

# Rate limit (requests/minute per IP) applied to /v1/chat and
# /v1/chat/stream only — protects against abuse if the public chat key
# gets scraped from a page. 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=20

# CORS: "*" allows any website to call /v1/chat (needed for embeddable widgets).
# Restrict this to your domain(s) in production, comma-separated.
ALLOWED_ORIGINS=*

# ===== Bot identity =====
BOT_NAME=Company Assistant
SYSTEM_PROMPT=You are a helpful assistant that answers questions strictly using the provided company context. If the answer is not in the context, say you don't have that information.
